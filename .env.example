# Devzy Orders API — environment configuration
# Copy to `.env` and adjust for local development.

# HTTP server port
PORT=8080

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Shared secret expected in the `x-api-key` header for write operations.
# In a real deployment this would come from a secret manager.
API_KEY=local-dev-key

# Default currency for orders that do not specify one (ISO 4217).
DEFAULT_CURRENCY=USD

# Maximum number of line items allowed on a single order.
MAX_ORDER_ITEMS=50

# Optional default partner base URL documented for ops (callers may still override per request).
SHIPPING_PARTNER_BASE_URL=https://labels.example.com/v1/render
